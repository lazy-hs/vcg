  <property name="styleSheet">
   <string notr="true">QWidget#Form {
    background: #F4F7FB;
    color: #172033;
    font-family: Microsoft YaHei;
    font-size: 14px;
}
QFrame#headerCard, QFrame#controlCard, QFrame#logCard, QFrame#progressCard {
    background: #FFFFFF;
    border: 1px solid #E3E9F1;
    border-radius: 12px;
}
QLabel#titleLabel {
    color: #111827;
    font-size: 24px;
    font-weight: 700;
}
QLabel#subtitleLabel, QLabel#time_label, QLabel#logHintLabel, QLabel#sourceHintLabel {
    color: #7A8699;
}
QLabel#sectionTitle, QLabel#logTitle {
    color: #172033;
    font-size: 17px;
    font-weight: 700;
}
QLabel#label, QLabel#label_2, QLabel#label_3, QLabel#label_4, QLabel#source_label, QLabel#label_5 {
    color: #526074;
    font-weight: 600;
}
QLineEdit, QComboBox {
    min-height: 24px;
    padding: 7px 10px;
    background: #F8FAFD;
    border: 1px solid #D9E1EC;
    border-radius: 8px;
    selection-background-color: #2563EB;
}
QLineEdit:focus, QComboBox:focus {
    background: #FFFFFF;
    border: 1px solid #2563EB;
}
QLineEdit:disabled, QComboBox:disabled {
    color: #9AA5B5;
    background: #F1F4F8;
}
QComboBox::drop-down {
    width: 28px;
    border: none;
}
QComboBox QAbstractItemView {
    padding: 5px;
    background: #FFFFFF;
    border: 1px solid #D9E1EC;
    selection-background-color: #E8F0FF;
    selection-color: #172033;
}
QPushButton {
    min-height: 38px;
    padding: 0 16px;
    border-radius: 8px;
    font-weight: 600;
}
QPushButton#download_btn {
    color: #FFFFFF;
    background: #2563EB;
    border: 1px solid #2563EB;
}
QPushButton#download_btn:hover {
    background: #1D4ED8;
    border-color: #1D4ED8;
}
QPushButton#download_btn:pressed {
    background: #1E40AF;
}
QPushButton#clear_log_btn, QPushButton#save_img_path_btn {
    color: #435168;
    background: #FFFFFF;
    border: 1px solid #D9E1EC;
}
QPushButton#clear_log_btn:hover, QPushButton#save_img_path_btn:hover {
    color: #2563EB;
    background: #F5F8FF;
    border-color: #AFC5F5;
}
QPushButton:disabled {
    color: #A8B1BF;
    background: #EDF1F6;
    border-color: #E1E6ED;
}
QPlainTextEdit {
    padding: 10px;
    color: #344054;
    background: #F8FAFD;
    border: 1px solid #E0E6EF;
    border-radius: 9px;
    font-family: Cascadia Mono, Microsoft YaHei;
    font-size: 13px;
}
QProgressBar {
    min-height: 16px;
    max-height: 16px;
    color: #667085;
    background: #E8EDF5;
    border: none;
    border-radius: 8px;
    text-align: center;
    font-size: 11px;
}
QProgressBar::chunk {
    background: #2563EB;
    border-radius: 8px;
}</string>
